# Contact form delivery (Microsoft 365 via GoDaddy). Copy to .env.local for local testing and set the
# same variables in Netlify → Environment variables, then redeploy. Never commit a real password.
# The mailbox must have "Authenticated SMTP" enabled.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=sumair@axeract.ai
SMTP_PASS=
MAIL_TO=info@axeract.ai

# Optional: also forward each submission as JSON to a webhook (Slack incoming webhooks are formatted automatically).
CONTACT_WEBHOOK_URL=
