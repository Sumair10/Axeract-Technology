# Contact form delivery (Microsoft 365 via GoDaddy). Only SMTP_PASS is required; the rest default to these values.
# same variables in Netlify → Environment variables, then redeploy. Never commit a real password.
# The mailbox must have "Authenticated SMTP" enabled.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=sumair@axeract.ai
SMTP_PASS=
MAIL_TO=info@axeract.ai

# Optional: also forward each submission as JSON to a webhook (Slack incoming webhooks are formatted automatically).
CONTACT_WEBHOOK_URL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). When set, a cookie consent banner appears and
# analytics loads only after the visitor clicks Accept. Leave empty for no analytics and no banner.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (the content="..." value of the HTML-tag method).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
