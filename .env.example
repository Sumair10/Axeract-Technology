# Contact form delivery. Copy to .env.local (and set the same vars on the host) and fill in.
# Submissions are emailed over SMTP when SMTP_HOST/USER/PASS are set.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# Optional: also forward each submission as JSON to a webhook (Slack incoming webhooks are formatted automatically).
CONTACT_WEBHOOK_URL=
